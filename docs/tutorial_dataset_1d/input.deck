### USER DEFINED CONSTANTS ###
begin:constant
  # Laser details
  I_peak = 1e+24 # Peak intensity of the laser [Wm^-2]
  lambda_L = 1e-6 # Wavelength of the laser
  t_fwhm_L = 16e-15 # Intensity fwhm in t

  # Target details
  n_elec = 1e+27 # Average electron number density [m^-3]
  density_profile = if(x lt 0, 0, 1)

  # Simulation details
  mppc = 50 # Macro particles per cell
  min_den_fact = 1e-4 # Minumum density factor (must be much less than 1!)
end:constant

begin:control
  t_end = 200e-15
  nx = 200
  x_min = -5e-6
  x_max =  15e-6
  nparticles = nint( x_max / (x_max - x_min) * nx * mppc)
  dt_multiplier = 0.8
  smooth_currents = T
  dlb_threshold = 0.8
  stdout_frequency = 100 # Print ETA
end:control

### LASER FOCUSING CONSTANTS ###
begin:constant
  # Temporal profile
  t_w = t_fwhm_L / (sqrt(2*loge(2))) # Field waist in t
  t_hw01m = t_w * sqrt(loge(10)) # Half width 0.1 maximum
end:constant

begin:laser
  boundary = x_min
  intensity = I_peak 
  lambda = lambda_L
  t_profile = gauss(time, t_hw01m, t_w) # Temporal profile
  phase = 0
end:laser

begin:boundaries
  bc_x_min_field = simple_laser
  bc_x_max_field = simple_outflow
  bc_x_min_particle = reflect
  bc_x_max_particle = reflect
end:boundaries

begin:species
  name = Electron
  frac = 0.5
  temp_ev = 1e3
  number_density_min = n_elec * min_den_fact
  number_density = n_elec * density_profile
  identify:electron
end:species

begin:species
  name = Ion
  frac = 0.5
  temp = temp_x(Electron)
  number_density_min = n_elec * min_den_fact
  number_density = n_elec * density_profile
  identify:proton
end:species

begin:dist_fn
  name = px_py
  ndims = 2
  dumpmask = always
  direction1 = dir_px
  direction2 = dir_py
  range1 = (-1.5e-21, 1.5e-21)
  range2 = (-1.5e-21, 1.5e-21)
  resolution1 = 200
  resolution2 = 200
  include_species:Electron
end:dist_fn

begin:probe
   name = Electron_Probe
   point = 0
   normal = -1
   ek_min = 0
   ek_max = -1
   include_species : Electron
   dumpmask = always
end:probe

begin:output_global
  force_final_to_be_restartable = F
end:output_global

begin:output
  name = normal
  dt_snapshot = 5e-15

  # Particle data
  particles = never
  px = never
  py = never
  pz = never
  particle_weight = never
  particle_probes = always

  # Grid data
  grid = always
  ex = always
  ey = always
  bz = always
  number_density = always + species + no_sum
  temperature = always + species + no_sum

  # Other
  total_energy_sum = always + species
  distribution_functions = always
  absorption = always
end:output
